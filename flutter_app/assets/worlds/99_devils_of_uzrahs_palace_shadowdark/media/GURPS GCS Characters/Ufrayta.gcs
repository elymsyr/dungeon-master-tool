					"cost_adj": "5"
				},
				{
					"id": "mBbW569f2SL2G296Z",
					"name": "No Brain",
					"reference": "B61",
					"local_notes": "Brain cannot be targeted. Blows to the skull or eye are treated like blows to the face, except that eye injury can still cripple the eye",
					"cost_adj": "5"
				},
				{
					"id": "mq0ryX4Fl46DOfpFn",
					"name": "No Eyes",
					"reference": "B61",
